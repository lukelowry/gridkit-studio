# Ship only the bundles, their assets, and the notices; vsce adds package.json.
**
!assets/{gridkit.png,gridkit.svg,monitor.svg,walkthrough.md}
!dist/extension.cjs
!dist/browser/*.{cjs,mjs}
!dist/worker.mjs
!dist/solver.mjs
!dist/solver/**
!dist/webview/*.{js,css,wasm,bin}
!dist/webview/maps/*.geojson.gz
!dist/licenses/*.md
!LICENSE
!README.md
!THIRD_PARTY_NOTICES.md
