{
  "name": "gridkit-studio",
  "displayName": "GridKit Studio",
  "version": "0.3.0",
  "description": "Explore, edit, and simulate power-system cases with native VS Code tools and Latkit.",
  "publisher": "lukelowery",
  "author": "Luke Lowery",
  "license": "MIT",
  "icon": "assets/gridkit.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukelowry/gridkit-studio"
  },
  "homepage": "https://github.com/lukelowry/gridkit-studio#readme",
  "bugs": {
    "url": "https://github.com/lukelowry/gridkit-studio/issues"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "GridKit",
    "power systems",
    "simulation",
    "Latkit"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24",
    "vscode": "^1.140.0"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onWebviewPanel:gridkitStudio.monitor"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit && svelte-check --tsconfig tsconfig.webview.json",
    "build": "pnpm typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:host": "pnpm build && node tests/extension/run.mjs",
    "test:solver": "node tests/solver/run.mjs",
    "test:performance": "node tests/performance.mjs",
    "vscode:prepublish": "pnpm build",
    "package": "pnpm exec vsce package --pre-release --no-dependencies --out dist/gridkit-studio-0.3.0.vsix",
    "format": "prettier --write src tests *.mjs *.ts *.json .github/workflows .vscode",
    "format:check": "prettier --check src tests *.mjs *.ts *.json .github/workflows .vscode",
    "lint": "eslint src tests *.mjs *.ts",
    "test:package": "node tests/extension/package.mjs"
  },
  "dependencies": {
    "@latkit/diagram": "0.8.0",
    "@latkit/gpu": "0.14.0",
    "@latkit/model": "3.0.0",
    "@latkit/monitor": "0.13.0",
    "@latkit/network": "0.18.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/vscode": "1.140.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "@webgpu/types": "^0.1.71",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Inspect and edit cases. Simulation requires Workspace Trust.",
      "restrictedConfigurations": [
        "gridkitStudio.simulationMethod",
        "gridkitStudio.dynamicSimulationPath",
        "gridkitStudio.containerImage"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Inspect and edit cases. Simulation requires a local filesystem on the workspace host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gridkitStudio.openCase",
        "title": "Open Case…",
        "category": "GridKit Studio",
        "icon": "$(folder-open)"
      },
      {
        "command": "gridkitStudio.preview",
        "title": "Open Network",
        "category": "GridKit Studio",
        "icon": "$(graph)"
      },
      {
        "command": "gridkitStudio.openDiagram",
        "title": "Open Diagram",
        "category": "GridKit Studio",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gridkitStudio.openTable",
        "title": "Open Table",
        "category": "GridKit Studio",
        "icon": "$(table)"
      },
      {
        "command": "gridkitStudio.showSource",
        "title": "Show Source",
        "category": "GridKit Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gridkitStudio.validateCase",
        "title": "Validate Case",
        "category": "GridKit Studio",
        "icon": "$(check)"
      },
      {
        "command": "gridkitStudio.fit",
        "title": "Fit View",
        "category": "GridKit Studio",
        "icon": "$(screen-full)"
      },
      {
        "command": "gridkitStudio.projection",
        "title": "Change Projection",
        "category": "GridKit Studio",
        "icon": "$(globe)"
      },
      {
        "command": "gridkitStudio.options",
        "title": "Display Options",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.orbit",
        "title": "Toggle Network Rotation",
        "category": "GridKit Studio",
        "icon": "$(sync)"
      },
      {
        "command": "gridkitStudio.elementSource",
        "title": "Show in Source",
        "category": "GridKit Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gridkitStudio.inspectField",
        "title": "Show in Table",
        "category": "GridKit Studio",
        "icon": "$(table)"
      },
      {
        "command": "gridkitStudio.showInTable",
        "title": "Show in Table",
        "category": "GridKit Studio",
        "icon": "$(table)"
      },
      {
        "command": "gridkitStudio.reveal",
        "title": "Reveal in Network",
        "category": "GridKit Studio",
        "icon": "$(target)"
      },
      {
        "command": "gridkitStudio.revealDiagram",
        "title": "Reveal in Diagram",
        "category": "GridKit Studio",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gridkitStudio.neighborhood",
        "title": "Focus Neighborhood",
        "category": "GridKit Studio",
        "icon": "$(target)"
      },
      {
        "command": "gridkitStudio.copyReference",
        "title": "Copy Reference",
        "category": "GridKit Studio",
        "icon": "$(copy)"
      },
      {
        "command": "gridkitStudio.chooseOverlapping",
        "title": "Choose Overlapping Element…",
        "category": "GridKit Studio",
        "icon": "$(list-selection)"
      },
      {
        "command": "gridkitStudio.fromEndpoint",
        "title": "From Bus",
        "category": "GridKit Studio",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gridkitStudio.toEndpoint",
        "title": "To Bus",
        "category": "GridKit Studio",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gridkitStudio.bind",
        "title": "Bind to View…",
        "category": "GridKit Studio",
        "icon": "$(link)"
      },
      {
        "command": "gridkitStudio.unbind",
        "title": "Remove Binding",
        "category": "GridKit Studio",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "gridkitStudio.bindingRange",
        "title": "Set Binding Range…",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.selectClass",
        "title": "Select Type…",
        "category": "GridKit Studio",
        "icon": "$(symbol-class)"
      },
      {
        "command": "gridkitStudio.filterTable",
        "title": "Filter Table…",
        "category": "GridKit Studio",
        "icon": "$(filter)"
      },
      {
        "command": "gridkitStudio.clearTableFilter",
        "title": "Clear Filter",
        "category": "GridKit Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "gridkitStudio.chooseColumns",
        "title": "Choose Columns…",
        "category": "GridKit Studio",
        "icon": "$(layout)"
      },
      {
        "command": "gridkitStudio.resetColumns",
        "title": "Reset Columns",
        "category": "GridKit Studio",
        "icon": "$(discard)"
      },
      {
        "command": "gridkitStudio.copyIdentifier",
        "title": "Copy Identifier",
        "category": "GridKit Studio",
        "icon": "$(copy)"
      },
      {
        "command": "gridkitStudio.copyValue",
        "title": "Copy Value",
        "category": "GridKit Studio",
        "icon": "$(copy)"
      },
      {
        "command": "gridkitStudio.editField",
        "title": "Edit Field…",
        "category": "GridKit Studio",
        "icon": "$(edit)"
      },
      {
        "command": "gridkitStudio.runSolver",
        "title": "Run Simulation",
        "category": "GridKit Studio",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted && gridkitStudio.hasCase && !gridkitStudio.running"
      },
      {
        "command": "gridkitStudio.stopSolver",
        "title": "Stop Simulation",
        "category": "GridKit Studio",
        "icon": "$(debug-stop)",
        "enablement": "gridkitStudio.running"
      },
      {
        "command": "gridkitStudio.clearRun",
        "title": "Clear Run",
        "category": "GridKit Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "gridkitStudio.openMonitor",
        "title": "Open Monitor",
        "category": "GridKit Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "gridkitStudio.plot",
        "title": "Plot Field",
        "category": "GridKit Studio",
        "icon": "$(graph-line)"
      },
      {
        "command": "gridkitStudio.monitorField",
        "title": "Choose Plots…",
        "category": "GridKit Studio",
        "icon": "$(add)"
      },
      {
        "command": "gridkitStudio.monitorWindow",
        "title": "Set Time Window…",
        "category": "GridKit Studio",
        "icon": "$(zoom-in)"
      },
      {
        "command": "gridkitStudio.monitorOptions",
        "title": "Plot Display Options…",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.toggleTimeline",
        "title": "Play",
        "category": "GridKit Studio",
        "icon": "$(play)"
      },
      {
        "command": "gridkitStudio.pauseTimeline",
        "title": "Pause",
        "category": "GridKit Studio",
        "icon": "$(debug-pause)"
      },
      {
        "command": "gridkitStudio.seekTime",
        "title": "Go to Time…",
        "category": "GridKit Studio",
        "icon": "$(watch)"
      },
      {
        "command": "gridkitStudio.chooseConfiguration",
        "title": "Choose Simulation Configuration…",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.saveConfiguration",
        "title": "Save Configuration As…",
        "category": "GridKit Studio",
        "icon": "$(save)"
      },
      {
        "command": "gridkitStudio.openConfiguration",
        "title": "Open Configuration",
        "category": "GridKit Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gridkitStudio.addEvent",
        "title": "Add Event…",
        "category": "GridKit Studio",
        "icon": "$(add)"
      },
      {
        "command": "gridkitStudio.addFault",
        "title": "Add Fault…",
        "category": "GridKit Studio",
        "icon": "$(add)"
      },
      {
        "command": "gridkitStudio.monitorSignals",
        "title": "Monitor Signals…",
        "category": "GridKit Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "gridkitStudio.signalElements",
        "title": "Choose Elements…",
        "category": "GridKit Studio",
        "icon": "$(list-selection)"
      },
      {
        "command": "gridkitStudio.findSignal",
        "title": "Find Signal…",
        "category": "GridKit Studio",
        "icon": "$(search)"
      },
      {
        "command": "gridkitStudio.removePlot",
        "title": "Remove Plot",
        "category": "GridKit Studio",
        "icon": "$(close)"
      },
      {
        "command": "gridkitStudio.previousSample",
        "title": "Previous Sample",
        "category": "GridKit Studio",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "gridkitStudio.nextSample",
        "title": "Next Sample",
        "category": "GridKit Studio",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "gridkitStudio.timeSpeed",
        "title": "Playback Speed…",
        "category": "GridKit Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "gridkitStudio.loopTime",
        "title": "Loop Playback",
        "category": "GridKit Studio",
        "icon": "$(sync)"
      },
      {
        "command": "gridkitStudio.followTime",
        "title": "Follow Latest Samples",
        "category": "GridKit Studio",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gridkitStudio.signalRange",
        "title": "Signal Color Range…",
        "category": "GridKit Studio",
        "icon": "$(symbol-number)"
      },
      {
        "command": "gridkitStudio.signalColormap",
        "title": "Choose Colormap…",
        "category": "GridKit Studio",
        "icon": "$(symbol-color)"
      },
      {
        "command": "gridkitStudio.openCsv",
        "title": "Open Monitor CSV…",
        "category": "GridKit Studio",
        "icon": "$(folder-open)"
      },
      {
        "command": "gridkitStudio.exportCsv",
        "title": "Export Run CSV…",
        "category": "GridKit Studio",
        "icon": "$(export)"
      },
      {
        "command": "gridkitStudio.unloopTime",
        "title": "Disable Loop",
        "category": "GridKit Studio",
        "icon": "$(sync)"
      },
      {
        "command": "gridkitStudio.unfollowTime",
        "title": "Stop Following Latest Samples",
        "category": "GridKit Studio",
        "icon": "$(debug-pause)"
      },
      {
        "command": "gridkitStudio.retryMonitor",
        "title": "Reload Monitor",
        "category": "GridKit Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "gridkitStudio.selectFault",
        "title": "Select Fault Bus",
        "category": "GridKit Studio",
        "icon": "$(target)"
      },
      {
        "command": "gridkitStudio.resetMonitorWindow",
        "title": "Reset Time Window",
        "category": "GridKit Studio",
        "icon": "$(screen-full)"
      },
      {
        "command": "gridkitStudio.showSolverOutput",
        "title": "Show Simulation Output",
        "category": "GridKit Studio",
        "icon": "$(terminal)"
      },
      {
        "command": "gridkitStudio.performance",
        "title": "Show Performance Diagnostics",
        "category": "GridKit Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "gridkitStudio.updateRuntime",
        "title": "Update Container Image",
        "category": "GridKit Studio",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gridkitStudio.fit",
          "when": "activeCustomEditorId == gridkitStudio.network || activeCustomEditorId == gridkitStudio.diagram",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.showSource",
          "when": "activeCustomEditorId == gridkitStudio.network || activeCustomEditorId == gridkitStudio.diagram",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "gridkitStudio.preview",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit"
        },
        {
          "command": "gridkitStudio.openDiagram",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit"
        },
        {
          "command": "gridkitStudio.openTable",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit"
        }
      ],
      "editor/context": [
        {
          "command": "gridkitStudio.preview",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit"
        },
        {
          "command": "gridkitStudio.openDiagram",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit"
        },
        {
          "command": "gridkitStudio.openTable",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit"
        }
      ],
      "view/title": [
        {
          "command": "gridkitStudio.runSolver",
          "when": "view == gridkitStudio.simulation",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.stopSolver",
          "when": "view == gridkitStudio.simulation",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.chooseConfiguration",
          "when": "view == gridkitStudio.simulation",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.findSignal",
          "when": "view == gridkitStudio.signals",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.monitorSignals",
          "when": "view == gridkitStudio.signals",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gridkitStudio.elementSource",
          "when": "view == gridkitStudio.inspector || view == gridkitStudio.signals",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.reveal",
          "when": "view == gridkitStudio.inspector || view == gridkitStudio.signals",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.revealDiagram",
          "when": "view == gridkitStudio.inspector || view == gridkitStudio.signals",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.showInTable",
          "when": "view == gridkitStudio.inspector || view == gridkitStudio.signals",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.editField",
          "when": "viewItem == editable",
          "group": "inline"
        },
        {
          "command": "gridkitStudio.copyValue",
          "when": "viewItem == editable",
          "group": "inline"
        },
        {
          "command": "gridkitStudio.plot",
          "when": "viewItem == signal",
          "group": "inline"
        },
        {
          "command": "gridkitStudio.bind",
          "when": "viewItem == signal",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "gridkitStudio.elementSource",
          "when": "webviewSection == element",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.inspectField",
          "when": "webviewSection == element",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.reveal",
          "when": "webviewSection == element",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.revealDiagram",
          "when": "webviewSection == element",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.neighborhood",
          "when": "webviewSection == element",
          "group": "navigation"
        },
        {
          "command": "gridkitStudio.copyReference",
          "when": "webviewSection == element",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gridkitStudio.network",
        "displayName": "GridKit Network",
        "selector": [
          {
            "filenamePattern": "*.[cC][aA][sS][eE].[jJ][sS][oO][nN]"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "gridkitStudio.diagram",
        "displayName": "GridKit Diagram",
        "selector": [
          {
            "filenamePattern": "*.[cC][aA][sS][eE].[jJ][sS][oO][nN]"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "gridkitStudio.tableEditor",
        "displayName": "GridKit Table",
        "selector": [
          {
            "filenamePattern": "*.[cC][aA][sS][eE].[jJ][sS][oO][nN]"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gridkitStudio",
          "title": "GridKit",
          "icon": "assets/gridkit.svg"
        }
      ]
    },
    "views": {
      "gridkitStudio": [
        {
          "id": "gridkitStudio.inspector",
          "name": "Inspector"
        },
        {
          "id": "gridkitStudio.signals",
          "name": "Signals"
        },
        {
          "id": "gridkitStudio.simulation",
          "name": "Simulation",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gridkitStudio.inspector",
        "contents": "Open a GridKit case to explore its network, controls, and signals.\n[Open Case](command:gridkitStudio.openCase)",
        "when": "!gridkitStudio.hasCase"
      }
    ],
    "taskDefinitions": [
      {
        "type": "gridkit",
        "required": [
          "case"
        ],
        "properties": {
          "case": {
            "type": "string",
            "description": "Case path, relative to the workspace folder."
          },
          "configuration": {
            "type": "string",
            "description": "Optional solver configuration path."
          }
        }
      }
    ],
    "configuration": {
      "title": "GridKit Studio",
      "properties": {
        "gridkitStudio.simulationMethod": {
          "type": "string",
          "enum": [
            "auto",
            "installed",
            "docker",
            "podman"
          ],
          "default": "auto",
          "scope": "machine-overridable",
          "description": "Auto checks DynamicSimulation, Docker, then Podman."
        },
        "gridkitStudio.dynamicSimulationPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "DynamicSimulation executable. Empty searches PATH."
        },
        "gridkitStudio.containerImage": {
          "type": "string",
          "default": "ghcr.io/lukelowry/gridkit:arrow",
          "scope": "machine-overridable",
          "description": "Container image, pulled only when missing. Resolved image identity is recorded."
        },
        "gridkitStudio.navigateOnSelection": {
          "type": "boolean",
          "default": true,
          "description": "Reveal selections in the active canvas."
        },
        "gridkitStudio.branchColorsFromBuses": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Color unbound branches from their endpoint buses."
        },
        "gridkitStudio.resultCacheMiB": {
          "type": "number",
          "default": 256,
          "minimum": 32,
          "maximum": 2048,
          "description": "Maximum result-window cache per extension window in MiB."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "gridkit_inspect_case",
        "displayName": "Inspect case",
        "modelDescription": "Inspect the active open GridKit case, counts, schema and units. Read only.",
        "userDescription": "Inspect the active open GridKit case, counts, schema and units. Read only.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "gridkit_inspect_case",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "gridkit_query_rows",
        "displayName": "Query case rows",
        "modelDescription": "Read at most 100 rows and 32 KiB from the active open GridKit case. Read only.",
        "userDescription": "Read at most 100 rows and 32 KiB from the active open GridKit case. Read only.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "gridkit_query_rows",
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Catalog type, such as Bus."
            },
            "select": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 40
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
