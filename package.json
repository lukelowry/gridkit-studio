              "Cool / Warm",
              "Cork",
              "Icefire",
              "Managua",
              "Pink / Green",
              "Purple / Orange",
              "Red / Blue",
              "Spectral",
              "Vanimo",
              "Vik",
              "Vlag",
              "Phase",
              "RomaO",
              "Twilight",
              "Turbo"
            ]
          },
          "gridkitStudio.network.ease": {
            "default": 0.3,
            "scope": "resource",
            "markdownDescription": "View — Transition duration. Seconds.",
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "gridkitStudio.network.height": {
            "default": 0.2,
            "scope": "resource",
            "markdownDescription": "View — Height. How high the highest mapped value raises a vertex: a share of the distance across the case.",
            "type": "number",
            "minimum": 0.01,
            "maximum": 1
          },
          "gridkitStudio.network.zoom": {
            "default": "wheel",
            "scope": "resource",
            "markdownDescription": "Interaction — Wheel behavior. Trackpad scrolls to pan and pinches to zoom.",
            "type": "string",
            "enum": [
              "wheel",
              "trackpad",
              "modifier",
              "off"
            ],
            "enumDescriptions": [
              "Wheel",
              "Trackpad",
              "Modifier + wheel",
              "Off"
            ]
          },
          "gridkitStudio.network.motion": {
            "default": "system",
            "scope": "resource",
            "markdownDescription": "Interaction — Motion",
            "type": "string",
            "enum": [
