    "configuration": [
      {
        "title": "GridKit Studio",
        "properties": {
          "gridkitStudio.gridkitPath": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "order": 0,
            "markdownDescription": "Where GridKit is installed, such as `/opt/gridkit`. Empty finds GridKit on `PATH`."
          },
          "gridkitStudio.gridkitImage": {
            "type": "string",
            "default": "ghcr.io/birchfieldresearchgroup/gridkit:develop-perf",
            "scope": "machine-overridable",
            "order": 1,
            "markdownDescription": "The container image GridKit runs from, in Docker or Podman, when GridKit is not installed where the workspace is. Pull it yourself first (`docker pull ghcr.io/birchfieldresearchgroup/gridkit:develop-perf`): GridKit Studio never pulls images. Empty runs only an installed GridKit."
          },
          "gridkitStudio.containerCli": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "order": 2,
            "markdownDescription": "The container CLI that runs **GridKit Image**: `docker`, `podman`, or a path to either. Empty uses `docker`, else `podman`, on `PATH`."
          },
          "gridkitStudio.gridkitProgram": {
            "type": "string",
            "default": "DynamicSimulation",
            "scope": "machine-overridable",
            "order": 3,
            "markdownDescription": "The GridKit program a run starts, with the solver file as its one argument. It is found under **GridKit Path**, on `PATH`, or in **GridKit Image**."
          },
          "gridkitStudio.catalog": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "order": 4,
            "markdownDescription": "A catalog of GridKit's classes to use in place of GridKit Studio's own, in the same form, for a GridKit build whose classes differ. A relative path starts at the first workspace folder. It is read when the window opens."
          },
          "gridkitStudio.resultCacheMiB": {
            "type": "number",
            "default": 256,
            "minimum": 0,
            "description": "Memory per window for results no view shows, in MiB, so they open again at once. Past it, those unused longest are closed."
          }
        }
      },
      {
        "id": "gridkitStudio.network",
        "title": "GridKit Studio: Network",
        "order": 1,
        "properties": {
          "gridkitStudio.network.projection": {
            "default": "mercator",
            "scope": "resource",
            "markdownDescription": "View — Projection",
            "type": "string",
            "enum": [
              "mercator",
              "globe"
            ],
            "enumDescriptions": [
              "Mercator",
              "Globe"
            ]
          },
          "gridkitStudio.network.tilt": {
            "default": 0,
            "scope": "resource",
            "markdownDescription": "View — Tilt",
            "type": "integer",
            "minimum": 0,
            "maximum": 75
          },
          "gridkitStudio.network.orbit": {
            "default": 0,
            "scope": "resource",
            "markdownDescription": "View — Orbit. Degrees per second.",
            "type": "integer",
            "minimum": -90,
            "maximum": 90
          },
          "gridkitStudio.network.labels": {
            "default": false,
            "scope": "resource",
            "markdownDescription": "View — Labels",
            "type": "boolean"
          },
          "gridkitStudio.network.vertexRadius": {
            "default": 2.5,
            "scope": "resource",
            "markdownDescription": "View — Vertex radius. Radius in CSS pixels, never under the edge width, so a vertex shows past the edges that meet it. Size mappings start from this radius.",
            "type": "number",
            "minimum": 2,
            "maximum": 12
          },
          "gridkitStudio.network.edgeWidth": {
            "default": 2,
            "scope": "resource",
            "markdownDescription": "View — Edge width. Width in CSS pixels, at least 2, as a thinner line can't hide what is behind it. Width mappings start from this width.",
            "type": "number",
            "minimum": 2,
            "maximum": 8
          },
          "gridkitStudio.network.colormap": {
            "default": "viridis",
            "scope": "resource",
            "markdownDescription": "View — Colormap",
            "type": "string",
            "enum": [
              "amber",
              "amp",
              "batlow",
              "cividis",
              "crest",
              "deep",
              "devon",
              "flare",
              "grays",
