    "walkthroughs": [
      {
        "id": "gridkitStudio.gettingStarted",
        "title": "Explore a GridKit case",
        "description": "Inspect, simulate, and plot.",
        "steps": [
          {
            "id": "open",
            "title": "Open a case",
            "description": "[Open Case](command:gridkitStudio.openCase). The Network opens as an editor. Case and Monitor are in the bottom panel.",
            "media": {
              "markdown": "assets/walkthrough.md"
            },
            "completionEvents": [
              "onCommand:gridkitStudio.openCase"
            ]
          },
          {
            "id": "inspect",
            "title": "Inspect",
            "description": "Select an element in the Network or the Case panel, and it is selected in the other views too.",
            "media": {
              "markdown": "assets/walkthrough.md"
            },
            "completionEvents": [
              "onCommand:gridkitStudio.openCasePanel"
            ]
          },
          {
            "id": "simulate",
            "title": "Simulate and plot",
            "description": "Monitored Signals shows what the case records, which its records list in their mon lists. Right-click a .solver.json and choose Run Dynamic Simulation. GridKit runs it where it is, and the Monitor plots what it writes.\n[Show Monitored Signals](command:gridkitStudio.signals.focus)",
            "media": {
              "markdown": "assets/walkthrough.md"
            },
            "completionEvents": [
              "onCommand:gridkitStudio.runSimulation"
            ]
          }
        ]
      }
