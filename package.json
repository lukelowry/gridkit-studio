    },
    "customEditors": [
      {
        "viewType": "gridkitStudio.network",
        "displayName": "Network",
        "selector": [
          {
            "filenamePattern": "*.[cC][aA][sS][eE].[jJ][sS][oO][nN]"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gridkitStudio",
          "title": "GridKit",
          "icon": "assets/gridkit.svg"
        }
      ],
      "panel": [
        {
          "id": "gridkitStudio-case",
          "title": "Case",
          "icon": "assets/gridkit.svg"
        },
        {
          "id": "gridkitStudio-monitor",
          "title": "Monitor",
          "icon": "assets/monitor.svg"
        }
      ]
    },
    "views": {
      "gridkitStudio": [
        {
          "id": "gridkitStudio.export",
          "name": "Export",
          "type": "webview"
        }
      ],
      "gridkitStudio-case": [
        {
          "id": "gridkitStudio.case",
          "name": "Case",
          "type": "webview"
        }
      ],
      "gridkitStudio-monitor": [
        {
          "id": "gridkitStudio.monitor",
          "name": "Monitor",
          "type": "webview"
        }
      ]
    },
    "configuration": [
      {
        "title": "GridKit Studio",
        "properties": {
          "gridkitStudio.gridkitPath": {
            "default": "",
            "scope": "machine-overridable",
            "order": 0,
            "markdownDescription": "GridKit installation directory or executable. Leave empty to use the included solver. Relative paths start at the workspace folder.",
            "type": "string"
          },
          "gridkitStudio.gridkitProgram": {
            "default": "DynamicSimulation",
            "scope": "machine-overridable",
            "order": 1,
            "markdownDescription": "Executable name to use when GridKit Path is an installation directory.",
            "type": "string"
          },
          "gridkitStudio.resultCacheMiB": {
            "default": 256,
            "scope": "window",
            "order": 2,
            "markdownDescription": "Memory, in MiB, for results no view shows, so they reopen at once. The least recently used are released first.",
            "type": "number",
            "minimum": 0
          }
        }
      },
      {
        "id": "gridkitStudio.network",
        "title": "GridKit Studio: Network",
        "order": 1,
        "properties": {
          "gridkitStudio.network.projection": {
            "default": "mercator",
            "scope": "resource",
            "order": 0,
            "type": "string",
            "enum": [
              "mercator",
              "globe"
            ],
            "enumItemLabels": [
              "Mercator",
              "Globe"
            ]
          },
          "gridkitStudio.network.tilt": {
            "default": 0,
            "scope": "resource",
            "order": 1,
            "markdownDescription": "Degrees from straight down.",
            "type": "integer",
            "minimum": 0,
            "maximum": 75
          },
          "gridkitStudio.network.orbit": {
            "default": 0,
            "scope": "resource",
            "order": 2,
            "markdownDescription": "Degrees per second.",
            "type": "integer"
          },
          "gridkitStudio.network.labels": {
            "default": false,
            "scope": "resource",
            "order": 3,
            "markdownDescription": "Show bus names.",
            "type": "boolean"
          },
          "gridkitStudio.network.vertexRadius": {
            "default": 2.5,
            "scope": "resource",
            "order": 4,
            "markdownDescription": "Radius in CSS pixels, at least the edge width. Size mappings start from this radius.",
            "type": "number",
            "minimum": 2
          },
          "gridkitStudio.network.edgeWidth": {
            "default": 2,
            "scope": "resource",
            "order": 5,
            "markdownDescription": "Width in CSS pixels, at least 2. Width mappings start from this width.",
            "type": "number",
            "minimum": 2
          },
          "gridkitStudio.network.colormap": {
            "default": "viridis",
            "scope": "resource",
            "order": 6,
            "type": "string",
            "enum": [
              "amber",
              "amp",
              "batlow",
              "cividis",
              "crest",
              "deep",
              "devon",
              "flare",
              "grays",
              "haline",
              "inferno",
              "lajolla",
              "magma",
              "mako",
              "oslo",
              "plasma",
              "rocket",
              "thermal",
              "turku",
              "viridis",
              "balance",
              "berlin",
              "brbg",
              "broc",
              "coolwarm",
              "cork",
              "icefire",
              "managua",
              "piyg",
              "puor",
              "rdbu",
              "spectral",
              "vanimo",
              "vik",
              "vlag",
              "phase",
              "romao",
              "twilight",
              "turbo"
            ],
            "enumItemLabels": [
              "Amber",
              "Amp",
              "Batlow",
              "Cividis",
              "Crest",
              "Deep",
              "Devon",
              "Flare",
              "Grays",
              "Haline",
              "Inferno",
              "Lajolla",
              "Magma",
              "Mako",
              "Oslo",
              "Plasma",
              "Rocket",
              "Thermal",
              "Turku",
              "Viridis",
              "Balance",
              "Berlin",
              "Brown / Green",
              "Broc",
              "Cool / Warm",
              "Cork",
              "Icefire",
              "Managua",
              "Pink / Green",
              "Purple / Orange",
              "Red / Blue",
              "Spectral",
              "Vanimo",
              "Vik",
              "Vlag",
              "Phase",
              "RomaO",
              "Twilight",
              "Turbo"
            ]
          },
          "gridkitStudio.network.transitionDuration": {
            "default": 0.3,
            "scope": "resource",
            "order": 7,
            "markdownDescription": "Seconds.",
            "type": "number",
            "minimum": 0
          },
          "gridkitStudio.network.height": {
            "default": 0.2,
            "scope": "resource",
            "order": 8,
            "markdownDescription": "Height of the largest mapped value, as a fraction of the case's width.",
            "type": "number",
            "minimum": 0.01
          },
          "gridkitStudio.network.wheelBehavior": {
            "default": "wheel",
            "scope": "resource",
            "order": 9,
            "type": "string",
            "enum": [
              "wheel",
              "trackpad",
              "modifier",
              "off"
            ],
            "enumItemLabels": [
              "Wheel zooms",
              "Scroll pans, pinch zooms",
              "Modifier + wheel zooms",
              "Off"
            ]
          },
          "gridkitStudio.network.motion": {
            "default": "system",
            "scope": "resource",
            "order": 10,
            "type": "string",
            "enum": [
              "system",
              "full",
              "reduced"
            ],
            "enumItemLabels": [
              "System",
              "Full",
              "Reduced"
            ]
          },
          "gridkitStudio.network.pickingDistance": {
            "default": 8,
            "scope": "resource",
            "order": 11,
            "markdownDescription": "How near the pointer finds an element, in CSS pixels.",
            "type": "integer",
            "minimum": 0
          }
        }
      },
      {
        "id": "gridkitStudio.map",
        "title": "GridKit Studio: Map",
        "order": 2,
        "properties": {
          "gridkitStudio.map.basemap": {
            "default": "naturalEarth",
            "scope": "resource",
            "order": 0,
            "markdownDescription": "The map under a geographic case.",
            "type": "string",
            "enum": [
              "naturalEarth",
              "openFreeMap",
              "custom",
              "none"
            ],
            "enumItemLabels": [
              "Natural Earth",
              "OpenFreeMap",
              "Custom",
              "None"
            ],
            "markdownEnumDescriptions": [
              "Included. Coasts, lakes, countries and states. Works offline.",
              "OpenStreetMap streets from openfreemap.org, fetched as you move. No key.",
              "OpenMapTiles vector tiles from `#gridkitStudio.map.tilesUrl#`.",
              "No map."
            ]
          },
          "gridkitStudio.map.waterColor": {
            "default": null,
            "scope": "resource",
            "order": 1,
            "markdownDescription": "Leave empty for a blue that suits the color theme.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "format": "color-hex"
          },
          "gridkitStudio.map.landColor": {
            "default": null,
            "scope": "resource",
            "order": 2,
            "markdownDescription": "Leave empty to follow the color theme.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "format": "color-hex"
          },
          "gridkitStudio.map.tilesUrl": {
            "default": "",
            "scope": "resource",
            "order": 3,
            "markdownDescription": "The Custom map's vector tiles, in OpenMapTiles' layers: a PMTiles archive, a TileJSON document, or a {z}/{x}/{y} URL.",
            "type": "string"
          },
          "gridkitStudio.map.attribution": {
            "default": "",
            "scope": "resource",
            "order": 4,
            "markdownDescription": "The credit shown under the Custom map. Leave empty for the credit its tiles ask for.",
            "type": "string"
          },
          "gridkitStudio.map.daylight": {
            "default": false,
            "scope": "resource",
            "order": 5,
            "markdownDescription": "Shade the map by the sun's position now.",
            "type": "boolean"
          },
          "gridkitStudio.map.nightBrightness": {
            "default": 0.3,
            "scope": "resource",
            "order": 6,
            "markdownDescription": "Brightness of the night side, from 0 to 1.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      {
        "id": "gridkitStudio.monitor",
        "title": "GridKit Studio: Monitor",
        "order": 3,
        "properties": {
          "gridkitStudio.monitor.interpolation": {
            "default": "linear",
            "scope": "resource",
            "order": 0,
            "type": "string",
            "enum": [
              "linear",
              "step"
            ],
            "enumItemLabels": [
              "Linear",
              "Step"
            ]
          },
          "gridkitStudio.monitor.lineWidth": {
            "default": 1,
            "scope": "resource",
            "order": 1,
            "markdownDescription": "CSS pixels.",
            "type": "number",
            "minimum": 0.25
          },
          "gridkitStudio.monitor.colormap": {
            "default": "tab10",
            "scope": "resource",
            "order": 2,
            "type": "string",
            "enum": [
              "dark2",
              "okabeito",
              "paired",
              "set2",
              "tab10",
              "tab20",
              "tableau10"
            ],
            "enumItemLabels": [
              "Dark2",
              "Okabe-Ito",
              "Paired",
              "Set2",
              "Tab10",
              "Tab20",
              "Tableau10"
            ]
          },
          "gridkitStudio.monitor.wheelBehavior": {
            "default": "wheel",
            "scope": "resource",
            "order": 3,
            "type": "string",
            "enum": [
              "wheel",
              "modifier",
              "off"
            ],
            "enumItemLabels": [
              "Wheel zooms",
              "Modifier + wheel zooms",
              "Off"
            ]
          },
          "gridkitStudio.monitor.motion": {
            "default": "system",
            "scope": "resource",
            "order": 4,
            "type": "string",
            "enum": [
              "system",
              "full",
              "reduced"
            ],
            "enumItemLabels": [
              "System",
              "Full",
              "Reduced"
            ]
          },
          "gridkitStudio.monitor.pickingDistance": {
            "default": 8,
            "scope": "resource",
            "order": 5,
            "markdownDescription": "How near the pointer finds a trace, in CSS pixels.",
            "type": "integer",
            "minimum": 0
          }
        }
      },
      {
        "id": "gridkitStudio.export",
        "title": "GridKit Studio: Export",
        "order": 4,
        "properties": {
          "gridkitStudio.export.width": {
            "default": 1920,
            "scope": "resource",
            "order": 0,
            "markdownDescription": "Width of videos and images from the Export view, in pixels.",
            "type": "integer",
            "minimum": 4
          },
          "gridkitStudio.export.height": {
            "default": 1080,
            "scope": "resource",
            "order": 1,
            "markdownDescription": "Height of videos and images from the Export view, in pixels.",
            "type": "integer",
            "minimum": 2
          },
          "gridkitStudio.export.scale": {
            "default": 2,
            "scope": "resource",
            "order": 2,
            "markdownDescription": "Pixels per CSS pixel. At 2, views lay out at half the size and draw twice as sharp.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "gridkitStudio.export.frameRate": {
            "default": 30,
            "scope": "resource",
            "order": 3,
            "markdownDescription": "Video frames per second.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "gridkitStudio.export.bitsPerPixel": {
            "default": 0.15,
            "scope": "resource",
            "order": 4,
            "markdownDescription": "Video bits per pixel per frame. Higher is sharper and larger.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "gridkitStudio.export.imageFormat": {
            "default": "png",
            "scope": "resource",
            "order": 5,
            "markdownDescription": "Format of exported images.",
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp"
            ],
            "enumItemLabels": [
              "PNG",
              "JPEG",
              "WebP"
            ]
          },
          "gridkitStudio.export.jpegQuality": {
            "default": 90,
            "scope": "resource",
            "order": 6,
            "markdownDescription": "JPEG quality, from 1 (smallest) to 100 (sharpest).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "gridkitStudio.export.transparent": {
            "default": false,
            "scope": "resource",
            "order": 7,
            "markdownDescription": "Leave the background of PNG and WebP images transparent.",
            "type": "boolean"
          },
          "gridkitStudio.export.theme": {
            "default": "auto",
            "scope": "resource",
            "order": 8,
            "markdownDescription": "Colors of videos and images from the Export view.",
            "type": "string",
            "enum": [
              "auto",
              "light",
              "dark"
            ],
            "enumItemLabels": [
              "Match VS Code",
              "Light",
              "Dark"
            ]
          },
          "gridkitStudio.export.caption": {
            "default": false,
            "scope": "resource",
            "order": 9,
            "markdownDescription": "Show the case name and time above videos and images from the Export view.",
            "type": "boolean"
          },
          "gridkitStudio.export.legend": {
            "default": false,
            "scope": "resource",
            "order": 10,
            "markdownDescription": "Show a legend for each color mapped onto the Network in videos and images from the Export view.",
            "type": "boolean"
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "gridkitStudio.gettingStarted",
        "title": "Explore a GridKit case",
        "description": "Inspect, simulate, and plot.",
        "steps": [
          {
            "id": "open",
            "title": "Open a case",
            "description": "[Open Case](command:gridkitStudio.openCase). The Network opens as an editor. Case and Monitor are in the bottom panel.",
            "media": {
              "markdown": "assets/walkthrough.md"
            },
            "completionEvents": [
              "onContext:gridkitStudio.hasCase"
            ]
          },
          {
            "id": "inspect",
            "title": "Inspect",
            "description": "Select an element in the Network or the Case panel, and it is selected in the other views too.",
            "media": {
              "markdown": "assets/walkthrough.md"
            },
            "completionEvents": [
              "onContext:gridkitStudio.hasSelection"
            ]
          },
          {
            "id": "simulate",
            "title": "Simulate and plot",
            "description": "Right-click a .solver.json and choose Run Dynamic Simulation. The Monitor lists each signal in the case's mon lists and plots the results as GridKit writes them.\n[Open Monitor](command:gridkitStudio.openMonitor)",
            "media": {
              "markdown": "assets/walkthrough.md"
            },
            "completionEvents": [
              "onContext:gridkitStudio.hasResults"
            ]
          }
        ]
      }
    ]
  },
  "browser": "./dist/browser/extension.cjs"
}
