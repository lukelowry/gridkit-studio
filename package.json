          },
          "gridkitStudio.network.map.daylight": {
            "default": false,
            "scope": "resource",
            "markdownDescription": "Map — Daylight",
            "type": "boolean"
          },
          "gridkitStudio.network.map.ground": {
            "default": null,
            "scope": "resource",
            "markdownDescription": "Map — Ground color. Null follows the current VS Code theme.",
            "type": [
              "string",
