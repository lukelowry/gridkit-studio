{
  "name": "gridkit-studio",
  "displayName": "GridKit Studio",
  "version": "0.7.0",
  "description": "Explore and simulate power-system cases with native VS Code tools and Latkit.",
  "publisher": "lukelowery",
  "author": "Luke Lowery",
  "license": "MIT",
  "icon": "assets/gridkit.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukelowry/gridkit-studio"
  },
  "homepage": "https://github.com/lukelowry/gridkit-studio#readme",
  "bugs": {
    "url": "https://github.com/lukelowry/gridkit-studio/issues"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "GridKit",
    "power systems",
    "simulation",
    "Latkit"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24",
    "vscode": "^1.140.0"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "pnpm typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.tests.json --noEmit && svelte-check --tsconfig tsconfig.webview.json",
    "quality": "pnpm format:check && pnpm lint && pnpm settings:check && pnpm typecheck && pnpm test",
    "format": "prettier --write src tests scripts *.mjs *.ts *.json .github/workflows .vscode",
    "format:check": "prettier --check src tests scripts *.mjs *.ts *.json .github/workflows .vscode",
    "lint": "eslint src tests scripts *.mjs *.ts",
    "settings": "node scripts/settings.mjs",
    "settings:check": "node scripts/settings.mjs --check",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage --testTimeout=60000",
    "test:contract": "vitest run --project contract",
    "test:host": "pnpm build && node tests/launch.mjs",
    "test:trust": "pnpm build && node tests/launch.mjs --untrusted tests/host/trust.ts",
    "test:package": "node tests/package.mjs",
    "test:e2e": "pnpm build && node tests/launch.mjs tests/e2e/index.ts",
    "bench": "pnpm build && node tests/launch.mjs tests/benchmarks/views.ts",
    "bench:playback": "pnpm build && node tests/launch.mjs tests/benchmarks/playback.ts",
    "bench:windowed": "pnpm build && node tests/launch.mjs tests/benchmarks/windowed-playback.ts",
    "bench:scrub": "pnpm build && node tests/launch.mjs tests/benchmarks/scrub.ts",
    "bench:compare": "node tests/benchmarks/compare.mjs output/bench/base.json output/bench/head.json",
    "screenshots": "pnpm build && node tests/launch.mjs tests/e2e/screenshots.ts",
    "package": "pnpm exec vsce package --no-dependencies --out dist/",
    "vscode:prepublish": "node esbuild.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "latkit": "0.6.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "1.140.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "mocha": "12.0.3",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Inspect cases. Simulation requires Workspace Trust.",
      "restrictedConfigurations": [
        "gridkitStudio.gridkitPath",
        "gridkitStudio.gridkitImage",
        "gridkitStudio.containerCli",
        "gridkitStudio.gridkitProgram",
        "gridkitStudio.catalog",
        "gridkitStudio.network.map.tilesUrl"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GridKit Studio reads case files on the workspace host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gridkitStudio.openCase",
        "title": "Open Case…",
        "category": "GridKit Studio",
        "icon": "$(folder-open)"
      },
      {
        "command": "gridkitStudio.openNetwork",
        "title": "Open Network",
        "category": "GridKit Studio",
        "icon": "$(globe)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.revealInNetwork",
        "title": "Reveal in Network",
        "category": "GridKit Studio",
        "icon": "$(globe)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.openCasePanel",
        "title": "Open Case Panel",
        "category": "GridKit Studio",
        "icon": "$(table)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.revealInCase",
        "title": "Reveal in Case Panel",
        "category": "GridKit Studio",
        "icon": "$(table)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.openMonitor",
        "title": "Open Monitor",
        "category": "GridKit Studio",
        "icon": "$(graph-line)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.openSource",
        "title": "Open JSON Source",
        "category": "GridKit Studio",
        "icon": "$(json)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.revealInSource",
        "title": "Reveal in Source",
        "category": "GridKit Studio",
        "icon": "$(go-to-file)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.goToReference",
        "title": "Go to Referenced Element",
        "category": "GridKit Studio",
        "icon": "$(references)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.copyId",
        "title": "Copy ID",
        "category": "GridKit Studio",
        "icon": "$(copy)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.copyValue",
        "title": "Copy Value",
        "category": "GridKit Studio",
        "icon": "$(copy)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.copyFieldPath",
        "title": "Copy Field Path",
        "category": "GridKit Studio",
        "icon": "$(copy)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.runSimulation",
        "title": "Run Dynamic Simulation",
        "category": "GridKit Studio",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gridkitStudio.showLastResults",
        "title": "Show Last Results",
        "category": "GridKit Studio",
        "icon": "$(graph-line)"
      },
      {
        "command": "gridkitStudio.runSimulationAgain",
        "title": "Run Simulation Again",
        "category": "GridKit Studio",
        "icon": "$(debug-rerun)",
        "enablement": "isWorkspaceTrusted && gridkitStudio.fromSolver && !gridkitStudio.running"
      },
      {
        "command": "gridkitStudio.stopSimulation",
        "title": "Stop Simulation",
        "category": "GridKit Studio",
        "icon": "$(debug-stop)",
        "enablement": "gridkitStudio.running"
      },
      {
        "command": "gridkitStudio.clearResults",
        "title": "Clear Results",
        "category": "GridKit Studio",
        "icon": "$(clear-all)",
        "enablement": "gridkitStudio.hasResults"
      },
      {
        "command": "gridkitStudio.plotSignal",
        "title": "Plot Signal…",
        "category": "GridKit Studio",
        "icon": "$(graph-line)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.addPlot",
        "title": "Add Plot…",
        "category": "GridKit Studio",
        "icon": "$(graph-line)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.removePlot",
        "title": "Remove Plot",
        "category": "GridKit Studio",
        "icon": "$(close)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.choosePlotElement",
        "title": "Choose Plot Element…",
        "category": "GridKit Studio",
        "icon": "$(list-selection)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.openResults",
        "title": "Open Results…",
        "category": "GridKit Studio",
        "icon": "$(folder-open)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.exportCsv",
        "title": "Export CSV…",
        "category": "GridKit Studio",
        "icon": "$(export)",
        "enablement": "gridkitStudio.hasResults"
      },
      {
        "command": "gridkitStudio.showOutput",
        "title": "Show Output",
        "category": "GridKit Studio",
        "icon": "$(terminal)"
      },
      {
        "command": "gridkitStudio.playPause",
        "title": "Play or Pause",
        "category": "GridKit Studio",
        "icon": "$(play)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.goToTime",
        "title": "Go to Time…",
        "category": "GridKit Studio",
        "icon": "$(watch)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.previousSample",
        "title": "Previous Sample",
        "category": "GridKit Studio",
        "icon": "$(debug-step-back)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.nextSample",
        "title": "Next Sample",
        "category": "GridKit Studio",
        "icon": "$(debug-step-over)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.goToEnd",
        "title": "Go to End",
        "category": "GridKit Studio",
        "icon": "$(arrow-right)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.playbackSpeed",
        "title": "Playback Speed…",
        "category": "GridKit Studio",
        "icon": "$(dashboard)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.fit",
        "title": "Fit All",
        "category": "GridKit Studio",
        "icon": "$(screen-full)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.zoomToNeighborhood",
        "title": "Zoom to Neighborhood",
        "category": "GridKit Studio",
        "icon": "$(target)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.reloadView",
        "title": "Reload View",
        "category": "GridKit Studio",
        "icon": "$(refresh)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.timeWindow",
        "title": "Time Window…",
        "category": "GridKit Studio",
        "icon": "$(watch)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.valueRange",
        "title": "Value Range…",
        "category": "GridKit Studio",
        "icon": "$(symbol-number)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.selectOverlapping",
        "title": "Select Overlapping…",
        "category": "GridKit Studio",
        "icon": "$(list-selection)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.chooseType",
        "title": "Choose Type…",
        "category": "GridKit Studio",
        "icon": "$(symbol-class)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.filterRows",
        "title": "Filter Rows…",
        "category": "GridKit Studio",
        "icon": "$(filter)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.chooseColumns",
        "title": "Choose Columns…",
        "category": "GridKit Studio",
        "icon": "$(table)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.resetColumns",
        "title": "Reset Columns",
        "category": "GridKit Studio",
        "icon": "$(discard)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.sortAscending",
        "title": "Sort Ascending",
        "category": "GridKit Studio",
        "icon": "$(arrow-up)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.sortDescending",
        "title": "Sort Descending",
        "category": "GridKit Studio",
        "icon": "$(arrow-down)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.clearSort",
        "title": "Clear Sort",
        "category": "GridKit Studio",
        "icon": "$(close)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.filterToValue",
        "title": "Filter to This Value",
        "category": "GridKit Studio",
        "icon": "$(filter)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.clearFilter",
        "title": "Clear Filter",
        "category": "GridKit Studio",
        "icon": "$(clear-all)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.hideColumn",
        "title": "Hide Column",
        "category": "GridKit Studio",
        "icon": "$(eye-closed)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.mapTo",
        "title": "Map To…",
        "category": "GridKit Studio",
        "icon": "$(symbol-color)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.mappingRange",
        "title": "Mapping Range…",
        "category": "GridKit Studio",
        "icon": "$(arrow-both)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.removeMapping",
        "title": "Remove Mapping",
        "category": "GridKit Studio",
        "icon": "$(close)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.networkSettings",
        "title": "Network Settings",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.monitorSettings",
        "title": "Monitor Settings",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.exportVideo",
        "title": "Export Video…",
        "category": "GridKit Studio",
        "icon": "$(device-camera-video)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.exportImage",
        "title": "Export Image…",
        "category": "GridKit Studio",
        "icon": "$(device-camera)",
        "enablement": "gridkitStudio.hasCase"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gridkitStudio.fit",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.openSource",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "navigation@2"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@1"
        },
        {
          "command": "gridkitStudio.openMonitor",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@2"
        },
        {
          "command": "gridkitStudio.exportVideo",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@3"
        },
        {
          "command": "gridkitStudio.exportImage",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@4"
        },
        {
          "command": "gridkitStudio.reloadView",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "2_layout@2"
        },
        {
          "command": "gridkitStudio.networkSettings",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "4_settings@1"
        }
      ],
      "explorer/context": [
        {
          "command": "gridkitStudio.runSimulation",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.showLastResults",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@1"
        },
        {
          "command": "gridkitStudio.openNetwork",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@1"
        }
      ],
      "editor/context": [
        {
          "command": "gridkitStudio.runSimulation",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.showLastResults",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@1"
        },
        {
          "command": "gridkitStudio.openNetwork",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "gridkitStudio.runSimulation",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.showLastResults",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@1"
        }
      ],
      "view/title": [
        {
          "command": "gridkitStudio.chooseType",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.filterRows",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "navigation@2"
        },
        {
          "command": "gridkitStudio.clearFilter",
          "when": "view == gridkitStudio.case && gridkitStudio.caseFiltered",
          "group": "navigation@3"
        },
        {
          "command": "gridkitStudio.chooseColumns",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "navigation@4"
        },
        {
          "command": "gridkitStudio.resetColumns",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "1_columns@1"
        },
        {
          "command": "gridkitStudio.openSource",
          "when": "view == gridkitStudio.case && gridkitStudio.hasCase",
          "group": "2_source@1"
        },
        {
          "command": "gridkitStudio.stopSimulation",
          "when": "view == gridkitStudio.monitor && gridkitStudio.running",
          "group": "navigation@0"
        },
        {
          "command": "gridkitStudio.runSimulationAgain",
          "when": "view == gridkitStudio.monitor && gridkitStudio.fromSolver && !gridkitStudio.running",
          "group": "navigation@0"
        },
        {
          "command": "gridkitStudio.addPlot",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasCase",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.timeWindow",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasSamples",
          "group": "1_time@1"
        },
        {
          "command": "gridkitStudio.openResults",
          "when": "view == gridkitStudio.monitor",
          "group": "2_results@1"
        },
        {
          "command": "gridkitStudio.exportCsv",
          "when": "view == gridkitStudio.monitor",
          "group": "2_results@2"
        },
        {
          "command": "gridkitStudio.exportVideo",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasSamples",
          "group": "2_results@3"
        },
        {
          "command": "gridkitStudio.exportImage",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasSamples",
          "group": "2_results@4"
        },
        {
          "command": "gridkitStudio.clearResults",
          "when": "view == gridkitStudio.monitor",
          "group": "2_results@5"
        },
        {
          "command": "gridkitStudio.reloadView",
          "when": "view == gridkitStudio.monitor",
          "group": "3_view@1"
        },
        {
          "command": "gridkitStudio.monitorSettings",
          "when": "view == gridkitStudio.monitor",
          "group": "3_view@2"
        }
      ],
      "webview/context": [
        {
          "command": "gridkitStudio.selectOverlapping",
          "when": "gridkitOverlapping",
          "group": "navigation@0"
        },
        {
          "command": "gridkitStudio.revealInSource",
          "when": "gridkitElement",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.goToReference",
          "when": "gridkitElement && gridkitReference",
          "group": "navigation@2"
        },
        {
          "command": "gridkitStudio.revealInNetwork",
          "when": "gridkitElement && gridkitOrigin != network",
          "group": "navigation@3"
        },
        {
          "command": "gridkitStudio.revealInCase",
          "when": "gridkitElement && gridkitOrigin != case",
          "group": "navigation@4"
        },
        {
          "command": "gridkitStudio.zoomToNeighborhood",
          "when": "gridkitScope == element && gridkitElement",
          "group": "navigation@5"
        },
        {
          "command": "gridkitStudio.sortAscending",
          "when": "gridkitScope == column && gridkitSort != ascending",
          "group": "2_view@1"
        },
        {
          "command": "gridkitStudio.sortDescending",
          "when": "gridkitScope == column && gridkitSort != descending",
          "group": "2_view@2"
        },
        {
          "command": "gridkitStudio.clearSort",
          "when": "gridkitScope == column && gridkitSort",
          "group": "2_view@3"
        },
        {
          "command": "gridkitStudio.filterToValue",
          "when": "gridkitScope == value && gridkitScalar",
          "group": "2_view@4"
        },
        {
          "command": "gridkitStudio.clearFilter",
          "when": "gridkitOrigin == case && gridkitFiltered",
          "group": "2_view@5"
        },
        {
          "command": "gridkitStudio.hideColumn",
          "when": "gridkitScope == column",
          "group": "2_view@6"
        },
        {
          "command": "gridkitStudio.chooseColumns",
          "when": "gridkitScope == column",
          "group": "2_view@7"
        },
        {
          "command": "gridkitStudio.plotSignal",
          "when": "gridkitScope == element && gridkitElement && gridkitSampled",
          "group": "3_visualize@1"
        },
        {
          "command": "gridkitStudio.choosePlotElement",
          "when": "gridkitScope == plot",
          "group": "3_visualize@2"
        },
        {
          "command": "gridkitStudio.valueRange",
          "when": "gridkitScope == plot",
          "group": "3_visualize@3"
        },
        {
          "command": "gridkitStudio.mapTo",
          "when": "gridkitScope != element && gridkitBindable",
          "group": "3_visualize@4"
        },
        {
          "command": "gridkitStudio.mappingRange",
          "when": "gridkitScope != element && gridkitBound",
          "group": "3_visualize@5"
        },
        {
          "command": "gridkitStudio.removeMapping",
          "when": "gridkitScope != element && gridkitBound",
          "group": "3_visualize@6"
        },
        {
          "command": "gridkitStudio.copyValue",
          "when": "gridkitScope == value",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "gridkitStudio.copyId",
          "when": "gridkitElement",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "gridkitStudio.copyFieldPath",
          "when": "gridkitScope == column",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "gridkitStudio.removePlot",
          "when": "gridkitScope == plot",
          "group": "7_modification@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gridkitStudio.mapTo",
          "when": "view == gridkitStudio.signals && viewItem =~ /\\bmappable\\b/",
          "group": "inline@1"
        },
        {
          "command": "gridkitStudio.plotSignal",
          "when": "view == gridkitStudio.signals && viewItem =~ /\\brecorded\\b/",
          "group": "1_visualize@1"
        },
        {
          "command": "gridkitStudio.mapTo",
          "when": "view == gridkitStudio.signals && viewItem =~ /\\bmappable\\b/",
          "group": "1_visualize@2"
        },
        {
          "command": "gridkitStudio.mappingRange",
          "when": "view == gridkitStudio.signals && viewItem =~ /\\bmapped\\b/",
          "group": "1_visualize@3"
        },
        {
          "command": "gridkitStudio.removeMapping",
          "when": "view == gridkitStudio.signals && viewItem =~ /\\bmapped\\b/",
          "group": "1_visualize@4"
        },
        {
          "command": "gridkitStudio.copyFieldPath",
          "when": "view == gridkitStudio.signals && viewItem =~ /\\bfield\\b/",
          "group": "9_cutcopypaste@1"
        }
      ],
