{
  "name": "gridkit-studio",
  "displayName": "GridKit Studio",
  "version": "0.9.0",
  "description": "View and simulate GridKit power-system cases in VS Code.",
  "publisher": "lukelowery",
  "author": "Luke Lowery",
  "license": "MIT",
  "icon": "assets/gridkit.png",
  "galleryBanner": {
    "color": "#0e6660",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lukelowry/gridkit-studio"
  },
  "homepage": "https://github.com/lukelowry/gridkit-studio#readme",
  "bugs": {
    "url": "https://github.com/lukelowry/gridkit-studio/issues"
  },
  "qna": "https://github.com/lukelowry/gridkit-studio/issues",
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "GridKit",
    "power systems",
    "power grid",
    "dynamic simulation",
    "ORNL"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24",
    "vscode": "^1.141.0"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "pnpm typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.tests.json --noEmit && svelte-check --tsconfig tsconfig.webview.json",
    "quality": "pnpm format:check && pnpm lint && pnpm settings:check && pnpm typecheck && pnpm test",
    "format": "prettier --write src tests scripts *.mjs *.ts *.json .github/workflows .vscode",
    "format:check": "prettier --check src tests scripts *.mjs *.ts *.json .github/workflows .vscode",
    "lint": "eslint src tests scripts *.mjs *.ts",
    "settings": "node scripts/settings.mjs",
    "settings:check": "node scripts/settings.mjs --check",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage --testTimeout=60000",
    "test:contract": "vitest run --project contract",
    "test:host": "pnpm build && node tests/launch.mjs",
    "test:trust": "pnpm build && node tests/launch.mjs --untrusted tests/host/trust.ts",
    "test:package": "node tests/package.mjs",
    "test:e2e": "pnpm build && node tests/launch.mjs tests/e2e/index.ts",
    "bench": "pnpm build && node tests/launch.mjs tests/benchmarks/views.ts",
    "bench:scrub": "pnpm build && node tests/launch.mjs tests/benchmarks/scrub.ts",
    "bench:compare": "node tests/benchmarks/compare.mjs output/bench/base.json output/bench/head.json",
    "screenshots": "pnpm build && node tests/launch.mjs tests/e2e/screenshots.ts",
    "package": "vsce package --no-dependencies --out dist/",
    "vscode:prepublish": "node esbuild.mjs",
    "test:web": "pnpm build && node tests/browser.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "jsonc-parser": "3.3.1",
    "latkit": "0.12.1",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "1.140.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "mocha": "12.0.3",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tar": "^7.5.23",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Inspect cases. Simulation requires Workspace Trust.",
      "restrictedConfigurations": [
        "gridkitStudio.gridkitPath",
        "gridkitStudio.gridkitProgram",
        "gridkitStudio.map.tilesUrl"
      ]
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "gridkitStudio.openCase",
        "title": "Open Case…",
        "category": "GridKit Studio",
        "icon": "$(folder-open)"
      },
      {
        "command": "gridkitStudio.openNetwork",
        "title": "Open Network",
        "category": "GridKit Studio",
        "icon": "$(globe)"
      },
      {
        "command": "gridkitStudio.revealInNetwork",
        "title": "Reveal in Network",
        "category": "GridKit Studio",
        "icon": "$(globe)"
      },
      {
        "command": "gridkitStudio.openCasePanel",
        "title": "Open Case Panel",
        "category": "GridKit Studio",
        "icon": "$(table)"
      },
      {
        "command": "gridkitStudio.revealInCasePanel",
        "title": "Reveal in Case Panel",
        "category": "GridKit Studio",
        "icon": "$(table)"
      },
      {
        "command": "gridkitStudio.openMonitor",
        "title": "Open Monitor",
        "category": "GridKit Studio",
        "icon": "$(graph-line)"
      },
      {
        "command": "gridkitStudio.revealInMonitor",
        "title": "Reveal in Monitor",
        "category": "GridKit Studio",
        "icon": "$(graph-line)"
      },
      {
        "command": "gridkitStudio.showJson",
        "title": "Show JSON",
        "category": "GridKit Studio",
        "icon": "$(json)"
      },
      {
        "command": "gridkitStudio.copyId",
        "title": "Copy ID",
        "category": "GridKit Studio",
        "icon": "$(copy)"
      },
      {
        "command": "gridkitStudio.copyValue",
        "title": "Copy Value",
        "category": "GridKit Studio",
        "icon": "$(copy)"
      },
      {
        "command": "gridkitStudio.copyFieldPath",
        "title": "Copy Field Path",
        "category": "GridKit Studio",
        "icon": "$(copy)"
      },
      {
        "command": "gridkitStudio.runSimulation",
        "title": "Run Dynamic Simulation",
        "category": "GridKit Studio",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gridkitStudio.stopSimulation",
        "title": "Stop Simulation",
        "category": "GridKit Studio",
        "icon": "$(debug-stop)",
        "enablement": "gridkitStudio.running"
      },
      {
        "command": "gridkitStudio.clearResults",
        "title": "Clear Results",
        "category": "GridKit Studio",
        "icon": "$(clear-all)",
        "enablement": "gridkitStudio.hasResults"
      },
      {
        "command": "gridkitStudio.newMonitor",
        "title": "New Monitor…",
        "category": "GridKit Studio",
        "icon": "$(add)",
        "enablement": "false"
      },
      {
        "command": "gridkitStudio.splitMonitor",
        "title": "Split Monitor",
        "category": "GridKit Studio",
        "icon": "$(split-horizontal)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.unsplitMonitor",
        "title": "Unsplit Monitor",
        "category": "GridKit Studio",
        "icon": "$(close)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.previousMonitor",
        "title": "Show Previous Monitor",
        "category": "GridKit Studio",
        "icon": "$(arrow-up)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.nextMonitor",
        "title": "Show Next Monitor",
        "category": "GridKit Studio",
        "icon": "$(arrow-down)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.chooseElement",
        "title": "Choose Element…",
        "category": "GridKit Studio",
        "icon": "$(list-selection)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.openResults",
        "title": "Open Results…",
        "category": "GridKit Studio",
        "icon": "$(folder-open)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.exportCsv",
        "title": "Export CSV…",
        "category": "GridKit Studio",
        "icon": "$(export)",
        "enablement": "gridkitStudio.hasResults"
      },
      {
        "command": "gridkitStudio.showOutput",
        "title": "Show Output",
        "category": "GridKit Studio",
        "icon": "$(terminal)"
      },
      {
        "command": "gridkitStudio.playPause",
        "title": "Play or Pause",
        "category": "GridKit Studio",
        "icon": "$(play)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.goToTime",
        "title": "Go to Time…",
        "category": "GridKit Studio",
        "icon": "$(watch)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.previousSample",
        "title": "Previous Sample",
        "category": "GridKit Studio",
        "icon": "$(debug-step-back)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.nextSample",
        "title": "Next Sample",
        "category": "GridKit Studio",
        "icon": "$(debug-step-over)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.goToEnd",
        "title": "Go to End",
        "category": "GridKit Studio",
        "icon": "$(arrow-right)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.playbackSpeed",
        "title": "Playback Speed…",
        "category": "GridKit Studio",
        "icon": "$(dashboard)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.fitAll",
        "title": "Fit All",
        "category": "GridKit Studio",
        "icon": "$(screen-full)"
      },
      {
        "command": "gridkitStudio.reloadView",
        "title": "Reload View",
        "category": "GridKit Studio",
        "icon": "$(refresh)",
        "enablement": "gridkitStudio.hasCase"
      },
      {
        "command": "gridkitStudio.timeWindow",
        "title": "Time Window…",
        "category": "GridKit Studio",
        "icon": "$(watch)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.valueRange",
        "title": "Value Range…",
        "category": "GridKit Studio",
        "icon": "$(symbol-number)",
        "enablement": "gridkitStudio.hasSamples"
      },
      {
        "command": "gridkitStudio.chooseType",
        "title": "Choose Type…",
        "category": "GridKit Studio",
        "icon": "$(symbol-class)"
      },
      {
        "command": "gridkitStudio.filterRows",
        "title": "Filter Rows…",
        "category": "GridKit Studio",
        "icon": "$(filter)"
      },
      {
        "command": "gridkitStudio.chooseColumns",
        "title": "Choose Columns…",
        "category": "GridKit Studio",
        "icon": "$(table)"
      },
      {
        "command": "gridkitStudio.resetColumns",
        "title": "Reset Columns",
        "category": "GridKit Studio",
        "icon": "$(discard)"
      },
      {
        "command": "gridkitStudio.sortAscending",
        "title": "Sort Ascending",
        "category": "GridKit Studio",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gridkitStudio.sortDescending",
        "title": "Sort Descending",
        "category": "GridKit Studio",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gridkitStudio.clearSort",
        "title": "Clear Sort",
        "category": "GridKit Studio",
        "icon": "$(close)"
      },
      {
        "command": "gridkitStudio.filterToValue",
        "title": "Filter to This Value",
        "category": "GridKit Studio",
        "icon": "$(filter)"
      },
      {
        "command": "gridkitStudio.clearFilter",
        "title": "Clear Filter",
        "category": "GridKit Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "gridkitStudio.hideColumn",
        "title": "Hide Column",
        "category": "GridKit Studio",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gridkitStudio.mapTo",
        "title": "Map to…",
        "category": "GridKit Studio",
        "icon": "$(symbol-color)"
      },
      {
        "command": "gridkitStudio.mappingRange",
        "title": "Mapping Range…",
        "category": "GridKit Studio",
        "icon": "$(arrow-both)"
      },
      {
        "command": "gridkitStudio.removeMapping",
        "title": "Remove Mapping",
        "category": "GridKit Studio",
        "icon": "$(close)"
      },
      {
        "command": "gridkitStudio.networkSettings",
        "title": "Network Settings",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.monitorSettings",
        "title": "Monitor Settings",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.exportSettings",
        "title": "Export Settings",
        "category": "GridKit Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gridkitStudio.exportVideo",
        "title": "Export Video…",
        "category": "GridKit Studio",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "gridkitStudio.exportImage",
        "title": "Export Image…",
        "category": "GridKit Studio",
        "icon": "$(device-camera)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gridkitStudio.fitAll",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.showJson",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "navigation@2"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@1"
        },
        {
          "command": "gridkitStudio.openMonitor",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@2"
        },
        {
          "command": "gridkitStudio.exportVideo",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@3"
        },
        {
          "command": "gridkitStudio.exportImage",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "1_view@4"
        },
        {
          "command": "gridkitStudio.reloadView",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "3_view@1"
        },
        {
          "command": "gridkitStudio.networkSettings",
          "when": "activeCustomEditorId == gridkitStudio.network",
          "group": "3_view@2"
        }
      ],
      "explorer/context": [
        {
          "command": "gridkitStudio.runSimulation",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.openNetwork",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@1"
        }
      ],
      "editor/context": [
        {
          "command": "gridkitStudio.runSimulation",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.openNetwork",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@0"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "resourceFilename =~ /\\.case\\.json$/i",
          "group": "gridkit@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "gridkitStudio.runSimulation",
          "when": "resourceFilename =~ /\\.solver\\.json$/i",
          "group": "gridkit@0"
        }
      ],
      "view/title": [
        {
          "command": "gridkitStudio.chooseType",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.filterRows",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "navigation@2"
        },
        {
          "command": "gridkitStudio.clearFilter",
          "when": "view == gridkitStudio.case && gridkitStudio.caseFiltered",
          "group": "navigation@3"
        },
        {
          "command": "gridkitStudio.chooseColumns",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "navigation@4"
        },
        {
          "command": "gridkitStudio.resetColumns",
          "when": "view == gridkitStudio.case && gridkitStudio.caseReady",
          "group": "1_columns@1"
        },
        {
          "command": "gridkitStudio.showJson",
          "when": "view == gridkitStudio.case && gridkitStudio.hasCase",
          "group": "2_source@1"
        },
        {
          "command": "gridkitStudio.newMonitor",
          "when": "view == gridkitStudio.monitor",
          "group": "navigation@0"
        },
        {
          "command": "gridkitStudio.stopSimulation",
          "when": "view == gridkitStudio.monitor && gridkitStudio.running",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.splitMonitor",
          "when": "view == gridkitStudio.monitor && gridkitStudio.canSplit",
          "group": "1_monitors@1"
        },
        {
          "command": "gridkitStudio.timeWindow",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasSamples",
          "group": "1_time@1"
        },
        {
          "command": "gridkitStudio.openResults",
          "when": "view == gridkitStudio.monitor",
          "group": "2_results@1"
        },
        {
          "command": "gridkitStudio.exportCsv",
          "when": "view == gridkitStudio.monitor",
          "group": "2_results@2"
        },
        {
          "command": "gridkitStudio.exportVideo",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasSamples",
          "group": "2_results@3"
        },
        {
          "command": "gridkitStudio.exportImage",
          "when": "view == gridkitStudio.monitor && gridkitStudio.hasSamples",
          "group": "2_results@4"
        },
        {
          "command": "gridkitStudio.clearResults",
          "when": "view == gridkitStudio.monitor",
          "group": "2_results@5"
        },
        {
          "command": "gridkitStudio.reloadView",
          "when": "view == gridkitStudio.monitor",
          "group": "3_view@1"
        },
        {
          "command": "gridkitStudio.monitorSettings",
          "when": "view == gridkitStudio.monitor",
          "group": "3_view@2"
        },
        {
          "command": "gridkitStudio.exportSettings",
          "when": "view == gridkitStudio.export",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "gridkitStudio.showJson",
          "when": "gridkitStudio.element",
          "group": "navigation@1"
        },
        {
          "command": "gridkitStudio.revealInNetwork",
          "when": "gridkitStudio.element && gridkitStudio.origin != network",
          "group": "navigation@2"
        },
        {
          "command": "gridkitStudio.revealInCasePanel",
          "when": "gridkitStudio.element && gridkitStudio.origin != case",
          "group": "navigation@3"
        },
        {
          "command": "gridkitStudio.revealInMonitor",
          "when": "gridkitStudio.element && gridkitStudio.sampled && gridkitStudio.origin != monitor",
          "group": "navigation@4"
        },
        {
          "command": "gridkitStudio.sortAscending",
          "when": "gridkitStudio.scope == column && gridkitStudio.sort != ascending",
          "group": "2_view@1"
        },
        {
          "command": "gridkitStudio.sortDescending",
          "when": "gridkitStudio.scope == column && gridkitStudio.sort != descending",
          "group": "2_view@2"
        },
        {
          "command": "gridkitStudio.clearSort",
          "when": "gridkitStudio.scope == column && gridkitStudio.sort",
          "group": "2_view@3"
        },
        {
          "command": "gridkitStudio.filterToValue",
          "when": "gridkitStudio.scope == value && gridkitStudio.scalar",
          "group": "2_view@4"
        },
        {
          "command": "gridkitStudio.clearFilter",
          "when": "gridkitStudio.origin == case && gridkitStudio.caseFiltered",
          "group": "2_view@5"
        },
        {
          "command": "gridkitStudio.hideColumn",
          "when": "gridkitStudio.scope == column",
          "group": "2_view@6"
        },
        {
          "command": "gridkitStudio.chooseColumns",
          "when": "gridkitStudio.scope == column",
          "group": "2_view@7"
        },
        {
          "command": "gridkitStudio.chooseElement",
          "when": "gridkitStudio.scope == monitor",
          "group": "3_visualize@1"
        },
        {
          "command": "gridkitStudio.valueRange",
          "when": "gridkitStudio.scope == monitor",
          "group": "3_visualize@2"
        },
        {
          "command": "gridkitStudio.mapTo",
          "when": "gridkitStudio.scope != element && gridkitStudio.mappable",
          "group": "3_visualize@3"
        },
        {
          "command": "gridkitStudio.mappingRange",
          "when": "gridkitStudio.scope != element && gridkitStudio.mapped",
          "group": "3_visualize@4"
        },
        {
          "command": "gridkitStudio.removeMapping",
          "when": "gridkitStudio.scope != element && gridkitStudio.mapped",
          "group": "3_visualize@5"
        },
        {
          "command": "gridkitStudio.copyValue",
          "when": "gridkitStudio.scope == value",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "gridkitStudio.copyId",
          "when": "gridkitStudio.element",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "gridkitStudio.copyFieldPath",
          "when": "gridkitStudio.scope == column || gridkitStudio.scope == monitor",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "gridkitStudio.splitMonitor",
          "when": "gridkitStudio.scope == monitor && !gridkitStudio.shown",
          "group": "1_split@1"
        },
        {
          "command": "gridkitStudio.unsplitMonitor",
          "when": "gridkitStudio.scope == monitor && gridkitStudio.split",
          "group": "1_split@2"
        },
        {
          "command": "gridkitStudio.newMonitor",
          "when": "gridkitStudio.scope == monitors",
          "group": "1_new@1"
        },
        {
          "command": "gridkitStudio.splitMonitor",
          "when": "gridkitStudio.scope == monitors && gridkitStudio.canSplit",
          "group": "2_monitors@1"
        },
        {
          "command": "gridkitStudio.openResults",
          "when": "gridkitStudio.scope == monitors",
          "group": "3_results@1"
        },
        {
          "command": "gridkitStudio.monitorSettings",
          "when": "gridkitStudio.scope == monitors",
          "group": "4_view@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gridkitStudio.openNetwork",
          "when": "gridkitStudio.hasCase"
        },
        {
          "command": "gridkitStudio.revealInNetwork",
          "when": "false"
        },
        {
          "command": "gridkitStudio.openCasePanel",
          "when": "gridkitStudio.hasCase"
        },
        {
          "command": "gridkitStudio.revealInCasePanel",
          "when": "false"
        },
        {
          "command": "gridkitStudio.openMonitor",
          "when": "gridkitStudio.hasCase"
        },
        {
          "command": "gridkitStudio.revealInMonitor",
          "when": "false"
        },
        {
          "command": "gridkitStudio.showJson",
